# npm run setup creates private local values in .env.local.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Leave blank for automatic Docker setup, or supply your own connection string.
DATABASE_URL=
# Optional direct connection for migrations when DATABASE_URL uses a pooler.
MIGRATION_DATABASE_URL=
# Optional fixed local database port. Setup chooses a free high port by default.
# POSTGRES_PORT=5433

