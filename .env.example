# npm run setup creates private local values in .env.local.
BETTER_AUTH_SECRET=
# Origin you open in the browser; npm run dev serves on its port.
BETTER_AUTH_URL=http://localhost:3000
# Leave blank for automatic Docker setup, or supply your own connection string.
DATABASE_URL=
# Optional direct connection for migrations when DATABASE_URL uses a pooler.
MIGRATION_DATABASE_URL=
# Optional fixed local database port. Setup chooses a free high port by default.
# POSTGRES_PORT=5433


# --- Support Lab answer pipeline (optional) ---
# Without a key the lab runs in local mode: a deterministic Jev reader and
# knowledge-base answers, so demos and tests work offline.
# With a key, every model call goes through the Vercel AI SDK + OpenRouter.
# Each account can also save its own key in Pengaturan (stored encrypted);
# that key wins over this server-wide one for the account's work.
OPENROUTER_API_KEY=
# Model id per role (OpenRouter format). Defaults shown.
# LAB_JEV_MODEL=typesafe/jev-1.13
# LAB_FAST_MODEL=openai/gpt-4o-mini
# LAB_REASONING_MODEL=anthropic/claude-3.5-sonnet
# LAB_BASELINE_MODEL=anthropic/claude-3.5-sonnet
# LAB_JEV_TIMEOUT_MS=10000
# LAB_MODEL_TIMEOUT_MS=30000
# Optional proxy for the OpenRouter API.
# OPENROUTER_BASE_URL=
