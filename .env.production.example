# Production settings for compose.prod.yaml. Copy to .env.production (ignored
# by git), fill in real values, and keep the file private on the server:
#   docker compose -f compose.prod.yaml --env-file .env.production up -d --build

# External PostgreSQL. Keep the TLS parameters your provider requires
# (e.g. ?sslmode=require); never disable certificate verification.
DATABASE_URL=
# Optional direct connection for migrations when DATABASE_URL uses a pooler.
MIGRATION_DATABASE_URL=

# At least 32 random characters, e.g. the output of: openssl rand -hex 32
# Also encrypts per-account OpenRouter keys; rotating it makes saved keys
# unreadable, so owners would have to save them again.
BETTER_AUTH_SECRET=
# Public origin browsers use, including a non-default port. No trailing path.
BETTER_AUTH_URL=https://lab.example.com

# Client IP for sign-in rate limiting. Leave both blank behind a single proxy
# that sets a one-value X-Forwarded-For (Caddy, Traefik, Coolify). Behind a
# proxy chain, list the proxies' IPs/CIDRs. Behind Cloudflare, use its header
# only if the origin accepts Cloudflare traffic alone. See docs/deployment.md.
# TRUSTED_PROXIES=172.16.0.0/12
# IP_ADDRESS_HEADERS=cf-connecting-ip

# Host port mapping. Loopback by default for a reverse proxy on the same host.
APP_BIND=127.0.0.1
APP_PORT=3000

# --- Support Lab answer pipeline (optional) ---
# Blank = local mode (deterministic Jev reader and knowledge-base answers).
OPENROUTER_API_KEY=
# LAB_JEV_MODEL=typesafe/jev-1.13
# LAB_FAST_MODEL=deepseek/deepseek-v4.1-flash
# LAB_REASONING_MODEL=deepseek/deepseek-v4.1-flash
# LAB_BASELINE_MODEL=deepseek/deepseek-v4.1-flash
# LAB_JEV_TIMEOUT_MS=10000
# LAB_MODEL_TIMEOUT_MS=30000
# OPENROUTER_BASE_URL=
